#include <stdio.h>

int main()
{
    int i, j, space;
    int rows = 5;
    int value;

    for(i = 0; i < rows; i++)
    {
        for(space = 0; space < rows - i - 1; space++)
        {
            printf(" ");
        }

        value = 1;

        for(j = 0; j <= i; j++)
        {
            printf("%d ", value);
            value = value * (i - j) / (j + 1);
        }

        printf("\n");
    }

    return 0;
}
